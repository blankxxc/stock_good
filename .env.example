# FastAPI authentication runtime
# Comma-separated, exact browser origins allowed to send credentialed state changes.
STOCK_GOOD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep false only for local HTTP. Set true whenever the public site uses HTTPS.
STOCK_GOOD_SECURE_COOKIE=false

# true: visitors may create ordinary user accounts; false: hide and reject registration.
STOCK_GOOD_REGISTRATION_OPEN=true

# production/prod disables Swagger, ReDoc, and OpenAPI unless explicitly overridden.
STOCK_GOOD_ENVIRONMENT=local
# STOCK_GOOD_EXPOSE_API_DOCS=false

# Server-only Next.js rewrite target. Set before `npm run build`; rewrites are build-time.
BACKEND_INTERNAL_ORIGIN=http://127.0.0.1:8000

# Exact public origins accepted by the Next.js protected-route redirect guard.
PUBLIC_SITE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Existing public research data helpers currently read this compatibility value. It is not used as the proxy target.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
